# ═══════════════════════════════════════════
# DÉCOR ANALYTICS - Variables d'environnement
# ═══════════════════════════════════════════
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs.
# Ne commitez JAMAIS le vrai fichier .env dans Git !

# Base de données OVH PostgreSQL 16
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Environnement (development | production)
NODE_ENV=development

# Port du serveur Express
PORT=3000

# API Proginov (optionnel - fournie par Proginov)
# VITE_DECOR_API_URL=https://decor-discount-api.progiapps.fr/ws
# VITE_DECOR_API_KEY=VOTRE_CLE_API_ICI
